# ============================================
# SERVER
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE LOCAL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=[YOUR-DB-NAME]
DB_USER=[YOUR-POSTGRES-USER]
DB_PASSWORD=[YOUR-PASSWORD]

# ============================================
# DATABASE ONLINE (Supabase PostgreSQL)
# Get from: Supabase → Settings → Database → Connection string → Session pooler (recommended)
# ============================================
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ============================================
# SUPABASE STORAGE
# Get from: Supabase → Settings → API
# ============================================
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=documents

# ============================================
# AUTHENTICATION
# Generate a strong random string for JWT_SECRET
# Example: openssl rand -base64 64
# ============================================
JWT_SECRET=your-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# ============================================
# CORS
# URL of your frontend (Vercel URL or custom domain)
# ============================================
FRONTEND_URL=http://localhost:3000